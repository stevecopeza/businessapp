{
    "name": "stevecopeza/businessapp",
    "description": "BusinessApp — quoting and agreement platform for small service businesses",
    "version": "0.1.0",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "yoast/phpunit-polyfills": "^1.1",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php-stubs/wordpress-stubs": "^7.0",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "BusinessApp\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BusinessApp\\Tests\\Unit\\": "tests/unit/",
            "BusinessApp\\Tests\\Integration\\": "tests/integration/"
        }
    },
    "scripts": {
        "test": "XDEBUG_MODE=off php -d memory_limit=512M vendor/bin/phpunit --testsuite Unit",
        "test:integration": "XDEBUG_MODE=off php -d memory_limit=512M vendor/bin/phpunit --testsuite Integration",
        "test:all": "XDEBUG_MODE=off php -d memory_limit=512M vendor/bin/phpunit",
        "lint": "XDEBUG_MODE=off php -d memory_limit=512M vendor/bin/phpcs --cache=.phpcs.cache",
        "lint:fix": "XDEBUG_MODE=off php -d memory_limit=512M vendor/bin/phpcbf --cache=.phpcs.cache",
        "analyse": "php -d memory_limit=1024M vendor/bin/phpstan analyse"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
